{
  "name": "sprzatanie-notifier",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "gen:code": "node scripts/gen-flat-code.ts",
    "gen:vapid": "node scripts/gen-vapid.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "http_ece": "1.2.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  }
}
