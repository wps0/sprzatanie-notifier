{
  "name": "sprzatanie-notifier",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "build": "node scripts/build.ts",
    "dev": "node scripts/dev-server.ts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "gen:code": "node scripts/gen-flat-code.ts",
    "gen:vapid": "node scripts/gen-vapid.js",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "22.20.5",
    "http_ece": "1.2.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  }
}
