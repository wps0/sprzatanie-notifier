{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprzatanie",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The web app, built by `npm run build`. Requests that match no file
  // (that is, /api/*) go to the Worker.
  "assets": {"directory": "./dist"},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sprzatanie",
      // Replace with the id printed by `npx wrangler d1 create sprzatanie`.
      "database_id": "2e65c663-9f52-40e5-9d04-f874915c16d6",
      "migrations_dir": "migrations"
    }
  ],
  // Must match TICK_CRON and REFRESH_CRON in src/worker/app.ts.
  "triggers": {"crons": ["*/15 * * * *", "7 */6 * * *"]},
  "vars": {
    "TIMEZONE": "Europe/Warsaw",
    // Public half of the key pair from `npm run gen:vapid`.
    "VAPID_PUBLIC_KEY": "BG1HIIByez0sz1V2-LLOnJNZ2h51sJgIVMDWFnKN1zrFbkTLX2Ih2_ZPV4O-kyba96dMatL4tDVa0z1GeUskduY",
    // The app's address, e.g. https://sprzatanie.<account>.workers.dev
    "VAPID_SUBJECT": "https://sprzatanie.wieczoreksp.workers.dev",
    // Comma-separated origins of a separately hosted web app, if any.
    "ALLOWED_ORIGINS": ""
  },
  // Secrets, set with `npx wrangler secret put <NAME>`:
  // FLAT_CODE, SHEET_URL, VAPID_PRIVATE_KEY.
  "observability": {"enabled": true}
}
